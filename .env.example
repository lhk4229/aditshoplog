# PostgreSQL
POSTGRES_USER=aditshoplog
POSTGRES_PASSWORD=aditshoplog
POSTGRES_DB=aditshoplog
DATABASE_URL=postgresql://aditshoplog:aditshoplog@localhost:5432/aditshoplog

# Backend
PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Frontend public URL (인증/재설정 메일 링크)
APP_URL=http://localhost:3000

# Brevo SMTP (https://app.brevo.com → SMTP & API, Senders)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Frontend (로컬 개발)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend (AWS 프로덕션 — nginx 동일 origin, 빈 값)
