# Production environment (copy to .env on AWS server)
# cp deploy/.env.production.example .env

# PostgreSQL (docker-compose internal)
POSTGRES_USER=aditshoplog
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aditshoplog

# Backend
DATABASE_URL=postgresql://aditshoplog:change-me-strong-password@postgres:5432/aditshoplog
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://YOUR_SERVER_IP

# Frontend build arg (same origin via nginx — leave empty)
NEXT_PUBLIC_API_URL=

# Public URL (update after domain/HTTPS setup)
APP_URL=http://YOUR_SERVER_IP

# SMTP — Gmail (SMTP_PASS는 앱 비밀번호 16자리)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cookie Secure flag (optional — auto: true when APP_URL/CORS_ORIGIN is https://)
# COOKIE_SECURE=false
